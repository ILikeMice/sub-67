[sub_resource type="GDScript" id="GDScript_7dm0k"]
script/source = "extends Node2D

var cardslist = {1: [], 2:[], 3:[]}
var hovered_cards = []
var current_card = null
var active_tweens = {}

var numbers = range(11).map(func(i): return str(i))

var specials = [\"m5\",\"p3\",\"x2\"]

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	addcard(\"10\", 1)
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func addcard(card: String, player: int):
	
	var createdcard = Node2D.new()
	var carea = Area2D.new()
	var ccs = CollisionShape2D.new()
	var rect = RectangleShape2D.new()
	
	var sprite = Sprite2D.new()
	
	var path = \"res://assets/cards/%s.png\" % card
	print(path, \" exists: \", ResourceLoader.exists(path))

	var texture = load(path) as Texture2D
	print(\"texture: \", texture)
	sprite.texture = texture
	rect.size = Vector2(37, 50)
	ccs.shape = rect
	
	createdcard.add_child(sprite)
	carea.add_child(ccs)
	createdcard.add_child(carea)
	
	if player == 1:
		cardslist[player].append(card)
		$Cards_1.add_child(createdcard)
		print(cardslist)
	_connect(createdcard)
	print(card)

func _connect(card):
	for child in card.get_children():
		if child is Area2D:
			child.mouse_entered.connect(_highlight.bind(card))
			child.mouse_exited.connect(_unhigh.bind(card))
			break

func _unhigh(card) -> void:
	hovered_cards.erase(card)
	_update_hover()

func _highlight(card) -> void:
	if not hovered_cards.has(card):
		hovered_cards.append(card)
	_update_hover()

func _update_hover():
	var highest_card = null
	for card in hovered_cards:
		if highest_card == null or card.z_index > highest_card.z_index:
			highest_card = card
	if highest_card == current_card:
		return
	if current_card != null:
		_animate_card(current_card, 0)

	current_card = highest_card
	if current_card != null:
		_animate_card(current_card, -20)

func _animate_card(card, target_y):
	if active_tweens.has(card):
		active_tweens[card].kill()

	var sprite = findchild(card, \"Sprite2D\")
	var target_pos = Vector2(sprite.position.x, target_y)
	var tween = create_tween()
	active_tweens[card] = tween
	tween.tween_property(sprite, \"position\", target_pos, 0.1)

func findchild(parent: Node, type_name: String) -> Node:
	for child in parent.get_children():
		if child.is_class(type_name):
			return child
	return null
"

